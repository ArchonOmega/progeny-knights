# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only; never expose to the browser

# Random string; Vercel Cron sends it as a Bearer token
CRON_SECRET=change-me

# Base URL of the deployed site (used in LSL setup instructions)
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
